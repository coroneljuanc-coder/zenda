// Modelo de datos del catálogo de Zenda (ZTV-7).
// Reglas de negocio:
// - RN1: precios en pesos colombianos, enteros y mayores que 0.
// - RN2: cada producto pertenece a exactamente una categoría.
// - RN3: cada producto tiene al menos una variante, y el stock (por variante) nunca es negativo.
// - RN4: el slug es único, en minúsculas y sin tildes.
// Las reglas RN1 y RN3 también se protegen en la base de datos con restricciones CHECK
// (ver la migración inicial), y se validan antes de guardar con Zod (src/lib/catalogo/validacion.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String
  slug        String     @unique
  descripcion String?
  orden       Int        @default(0)
  creadoEn    DateTime   @default(now())
  productos   Producto[]
}

model Producto {
  id            String             @id @default(cuid())
  nombre        String
  slug          String             @unique
  descripcion   String
  /// Precio final en COP, con IVA incluido (D4). Entero mayor que 0.
  precio        Int
  categoriaId   String
  categoria     Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  activo        Boolean            @default(true)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  variantes     VarianteProducto[]
  imagenes      ImagenProducto[]

  @@index([categoriaId])
}

model VarianteProducto {
  id            String         @id @default(cuid())
  productoId    String
  producto      Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sku           String         @unique
  talla         String?
  color         String?
  /// Unidades disponibles. Nunca negativo.
  stock         Int            @default(0)
  /// Precio propio de la variante en COP. Si está vacío, se usa el del producto.
  precio        Int?
  lineasCarrito LineaCarrito[]
  lineasPedido  LineaPedido[]

  @@index([productoId])
}

// Carrito de un visitante (ZTV-16, épica E2). Se guarda en la base y se reconoce con una cookie,
// para que no se pierda al cerrar el navegador (RN5: dura 30 días desde la última modificación).
// RN3: agregar al carrito no reserva ni descuenta inventario. RN6: guarda variante y cantidad,
// nunca el precio, que siempre se toma del catálogo vigente.
model Carrito {
  id            String         @id @default(cuid())
  /// Identificador aleatorio y no adivinable que guarda la cookie `zenda_carrito`.
  token         String         @unique
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  /// RN5: 30 días después de la última modificación. Un carrito vencido ya no se usa.
  expiraEn      DateTime
  lineas        LineaCarrito[]
  datosEntrega  DatosEntrega?
  pedidos       Pedido[]
}

/// Estados del pedido (épica E3). Los de envío llegan con E5.
enum EstadoPedido {
  PENDIENTE_PAGO
  PAGADO
  PAGO_RECHAZADO
  CANCELADO
  REQUIERE_REVISION
}

/// ZTV-20: el pedido guarda una copia de todo lo que el cliente vio al tocar «Pagar» (RN2).
model Pedido {
  id                 String        @id @default(cuid())
  /// RN3: ZEN-AAAAMMDD-XXXXX. Es la referencia externa que se envía a la pasarela.
  referencia         String        @unique
  /// Aleatorio: permite consultar el resultado sin exponer datos (ZTV-22).
  tokenAcceso        String        @unique
  estado             EstadoPedido  @default(PENDIENTE_PAGO)
  subtotal           Int
  envio              Int
  total              Int
  /// Huella del contenido (líneas y total) para no duplicar el pedido con un doble clic.
  claveContenido     String
  nombreCompleto     String
  correo             String
  celular            String
  departamento       String
  ciudad             String
  codigoDane         String
  direccion          String
  detalles           String?
  notas              String?
  /// El carrito de origen; si el carrito se borra, el pedido se conserva.
  carritoId          String?
  carrito            Carrito?      @relation(fields: [carritoId], references: [id], onDelete: SetNull)
  /// ZTV-21 y ZTV-86: datos del pago confirmado por la pasarela (Mercado Pago, RN6).
  pasarelaTransaccionId String?
  metodoPago         String?
  pagadoEn           DateTime?
  creadoEn           DateTime      @default(now())
  actualizadoEn      DateTime      @updatedAt
  lineas             LineaPedido[]

  @@index([carritoId, estado])
}

model LineaPedido {
  id                  String           @id @default(cuid())
  pedidoId            String
  pedido              Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  varianteId          String
  variante            VarianteProducto @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  nombreProducto      String
  descripcionVariante String?
  precioUnitario      Int
  cantidad            Int
  totalLinea          Int

  @@index([pedidoId])
  @@index([varianteId])
}

/// ZTV-19: datos de contacto y envío del visitante, guardados con su carrito mientras dure (RN4).
model DatosEntrega {
  id               String   @id @default(cuid())
  carritoId        String   @unique
  carrito          Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  nombreCompleto   String
  correo           String
  celular          String
  departamento     String
  ciudad           String
  /// Código DANE (DIVIPOLA) del municipio.
  codigoDane       String
  direccion        String
  detalles         String?
  notas            String?
  /// Fecha y hora en que el visitante autorizó el tratamiento de sus datos (Ley 1581 de 2012).
  aceptoPoliticaEn DateTime
  actualizadoEn    DateTime @updatedAt
}

model LineaCarrito {
  id          String           @id @default(cuid())
  carritoId   String
  carrito     Carrito          @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  varianteId  String
  variante    VarianteProducto @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  /// RN1: de 1 a 10 (también protegido con una restricción CHECK en la base).
  cantidad    Int
  /// Precio que vio el visitante al agregar. Solo sirve para avisar «El precio de este producto
  /// cambió» (ZTV-17); el subtotal siempre usa el precio vigente del catálogo (RN6 de ZTV-16).
  precioVisto Int

  /// RN2: la misma variante nunca se repite en dos líneas del mismo carrito.
  @@unique([carritoId, varianteId])
  @@index([varianteId])
}

model ImagenProducto {
  id               String   @id @default(cuid())
  productoId       String
  producto         Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  url              String
  textoAlternativo String
  orden            Int

  @@unique([productoId, orden])
}

/// ZTV-21: cada aviso recibido de la pasarela queda registrado (trazabilidad), sea válido o no.
model EventoPago {
  id             String   @id @default(cuid())
  proveedor      String
  /// Identificador del pago en la pasarela.
  transaccionId  String?
  referencia     String?
  /// Estado que informó la pasarela (approved, rejected…).
  estado         String?
  recibidoEn     DateTime @default(now())
  /// Qué hizo Zenda con el aviso: pagado, rechazado, repetido, revision-monto, revision-stock…
  resultado      String

  @@index([referencia])
}

// ZTV-25: bandeja de salida de eventos («outbox»). El evento se guarda en la misma transacción que
// marca el pedido «Pagado» (RN1) y se entrega después al servicio de Notificaciones, con
// reintentos; el pago nunca espera esa entrega (RN2).
enum EstadoEvento {
  PENDIENTE
  ENTREGADO
  FALLIDO
}

model EventoSaliente {
  /// UUID del evento: el servicio de Notificaciones lo procesa una sola vez (RN3).
  id             String       @id @default(uuid())
  tipo           String
  version        Int
  /// Datos del evento según el contrato de @zenda/contratos.
  datos          Json
  ocurridoEn     DateTime     @default(now())
  estado         EstadoEvento @default(PENDIENTE)
  intentos       Int          @default(0)
  /// Cuándo se puede volver a intentar; también sirve de «reserva» mientras un proceso lo entrega.
  proximoIntento DateTime     @default(now())
  entregadoEn    DateTime?
  ultimoError    String?
  /// Un evento «pedido.pagado» por pedido (RN1).
  pedidoId       String?      @unique

  @@index([estado, proximoIntento])
}
