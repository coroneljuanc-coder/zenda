// Modelo de datos del catálogo de Zenda (ZTV-7).
// Reglas de negocio:
// - RN1: precios en pesos colombianos, enteros y mayores que 0.
// - RN2: cada producto pertenece a exactamente una categoría.
// - RN3: cada producto tiene al menos una variante, y el stock (por variante) nunca es negativo.
// - RN4: el slug es único, en minúsculas y sin tildes.
// Las reglas RN1 y RN3 también se protegen en la base de datos con restricciones CHECK
// (ver la migración inicial), y se validan antes de guardar con Zod (src/lib/catalogo/validacion.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String
  slug        String     @unique
  descripcion String?
  orden       Int        @default(0)
  creadoEn    DateTime   @default(now())
  productos   Producto[]
}

model Producto {
  id            String             @id @default(cuid())
  nombre        String
  slug          String             @unique
  descripcion   String
  /// Precio final en COP, con IVA incluido (D4). Entero mayor que 0.
  precio        Int
  categoriaId   String
  categoria     Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  activo        Boolean            @default(true)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  variantes     VarianteProducto[]
  imagenes      ImagenProducto[]

  @@index([categoriaId])
}

model VarianteProducto {
  id            String         @id @default(cuid())
  productoId    String
  producto      Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sku           String         @unique
  talla         String?
  color         String?
  /// Unidades disponibles. Nunca negativo.
  stock         Int            @default(0)
  /// Precio propio de la variante en COP. Si está vacío, se usa el del producto.
  precio        Int?
  lineasCarrito LineaCarrito[]

  @@index([productoId])
}

// Carrito de un visitante (ZTV-16, épica E2). Se guarda en la base y se reconoce con una cookie,
// para que no se pierda al cerrar el navegador (RN5: dura 30 días desde la última modificación).
// RN3: agregar al carrito no reserva ni descuenta inventario. RN6: guarda variante y cantidad,
// nunca el precio, que siempre se toma del catálogo vigente.
model Carrito {
  id            String         @id @default(cuid())
  /// Identificador aleatorio y no adivinable que guarda la cookie `zenda_carrito`.
  token         String         @unique
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  /// RN5: 30 días después de la última modificación. Un carrito vencido ya no se usa.
  expiraEn      DateTime
  lineas        LineaCarrito[]
  datosEntrega  DatosEntrega?
}

/// ZTV-19: datos de contacto y envío del visitante, guardados con su carrito mientras dure (RN4).
model DatosEntrega {
  id               String   @id @default(cuid())
  carritoId        String   @unique
  carrito          Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  nombreCompleto   String
  correo           String
  celular          String
  departamento     String
  ciudad           String
  /// Código DANE (DIVIPOLA) del municipio.
  codigoDane       String
  direccion        String
  detalles         String?
  notas            String?
  /// Fecha y hora en que el visitante autorizó el tratamiento de sus datos (Ley 1581 de 2012).
  aceptoPoliticaEn DateTime
  actualizadoEn    DateTime @updatedAt
}

model LineaCarrito {
  id          String           @id @default(cuid())
  carritoId   String
  carrito     Carrito          @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  varianteId  String
  variante    VarianteProducto @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  /// RN1: de 1 a 10 (también protegido con una restricción CHECK en la base).
  cantidad    Int
  /// Precio que vio el visitante al agregar. Solo sirve para avisar «El precio de este producto
  /// cambió» (ZTV-17); el subtotal siempre usa el precio vigente del catálogo (RN6 de ZTV-16).
  precioVisto Int

  /// RN2: la misma variante nunca se repite en dos líneas del mismo carrito.
  @@unique([carritoId, varianteId])
  @@index([varianteId])
}

model ImagenProducto {
  id               String   @id @default(cuid())
  productoId       String
  producto         Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  url              String
  textoAlternativo String
  orden            Int

  @@unique([productoId, orden])
}
