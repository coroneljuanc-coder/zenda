{
  "//": "Solo revisa los archivos de la raíz: pruebas E2E y configuraciones. Cada aplicación tiene su propio tsconfig.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts", "vitest.config.mts"]
}
