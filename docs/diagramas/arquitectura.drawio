        <mxCell id="reglas" value="&lt;b&gt;Reglas del negocio&lt;/b&gt;&lt;br&gt;· Precios en COP con IVA incluido&lt;br&gt;· Envío $12.000; gratis desde $200.000&lt;br&gt;· Inventario por variante, nunca negativo&lt;br&gt;· Pedido e inventario en una sola transacción&lt;br&gt;· Nunca se guardan datos de tarjetas" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4B2A9;fontColor=#444441;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="790" y="725" width="370" height="205" as="geometry"/></mxCell>
