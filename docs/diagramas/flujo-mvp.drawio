      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="&lt;b&gt;Zenda – Flujo de compra del MVP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Arquitectura C (ADR-001): tienda principal + servicio de Notificaciones · Todas las pantallas usan el diseño base ZTV-10&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="L0" value="Cliente (visitante)" style="swimlane;horizontal=0;html=1;startSize=150;fontSize=14;fontStyle=1;fillColor=#FFFFFF;swimlaneFillColor=#F4F2FF;strokeColor=#B4B2A9;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="2740" height="170" as="geometry"/></mxCell>
