        <mxCell id="inicio" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444441;fontColor=#2C2C2A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="130" width="50" height="50" as="geometry"/></mxCell>
